# Copy this file to ".env" (in the /server folder) and fill in your own values.

# Port the Express server listens on
PORT=3000

# Token from @BotFather after creating your bot with /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The chat/group id that should receive booking notifications
# (see README.md "Telegram bot setup" section for how to find this)
TELEGRAM_CHAT_ID=your_chat_or_group_id_here
